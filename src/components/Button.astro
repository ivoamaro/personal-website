---
let {
    isButton = true,
    isExternal = false,
    href = "",
    title = "",
} = Astro.props;

if (title === "" && isButton) title = "Button";
else if (title === "" && !isButton) title = "Link";
---

<style>
    .button-component {
        margin: 10px;
        display: block;
        font-family: "Open Sans", sans-serif;
        font-size: 16px;
        letter-spacing: 2px;
        text-decoration: none;
        text-transform: uppercase;
        color: #000;
        background-color: white;
        width: fit-content;
        cursor: pointer;
        border: 3px solid;
        padding: 10px 20px;
        position: relative;
        box-shadow:
            0.5px 0.5px 0,
            1px 1px 0,
            1.5px 1.5px 0,
            2px 2px 0,
            2.5px 2.5px 0;
        user-select: none;
        -webkit-user-select: none;
        touch-action: manipulation;
        transition: background-color 500ms;
    }

    .button-component:active {
        box-shadow: 0px 0px 0px 0px;
        top: 5px;
        left: 5px;
    }
</style>

{
    isButton ? (
        <button class="button-component" role="button">
            <span class="text">{title}</span>
        </button>
    ) : isExternal ? (
        <a
            href={href}
            target="_blank"
            rel="noreferrer"
            class="button-component"
        >
            <span class="text"> {title}</span>
        </a>
    ) : (
        <a href={href} class="button-component">
            <span class="text">{title}</span>
        </a>
    )
}
