---
import Button from "./ui/Button.astro";
---

<footer class="container">
  <div class="contact-info">
    <h1>Get in touch!</h1>
    <p>I’d love to chat, hear your ideas, and share a few of my own.</p>
  </div>
  <ul>
    <li>
      <Button
        title="Email"
        isButton={false}
        isExternal={true}
        href="mailto:ivo.amaro.97.p@gmail.com"
      />
    </li>
    <li>
      <Button
        title="Behance"
        isButton={false}
        isExternal={true}
        href="https://www.behance.net/ivoamaro"
      />
    </li>
    <li>
      <Button
        title="Github"
        isButton={false}
        isExternal={true}
        href="https://github.com/ivoamaro"
      />
    </li>
    <li>
      <Button
        title="Linkedin"
        isButton={false}
        isExternal={true}
        href="https://www.linkedin.com/in/ivo-amaro-9023b516b/"
      />
    </li>
  </ul>
</footer>

<style>
  footer {
    padding: var(--space-6);
    .contact-info {
      h1 {
        font-family: var(--font-primary);
        font-size: 160px;
        font-weight: var(--font-regular);
        margin-left: -10px;
        margin-bottom: var(--space-2);
      }
      p {
        font-family: var(--font-primary);
        font-size: var(--step-4);
        font-weight: var(--font-regular);
        line-height: 1;
        margin-bottom: var(--space-6);
      }
    }

    ul {
      display: flex;

      > * + * {
        margin-left: var(--space-4);
      }

      li {
        list-style-type: none;
      }
    }
  }
</style>
