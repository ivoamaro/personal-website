---
import ThemeIcon from "./ui/ThemeIcon.astro";
---

<nav class="container">
  <div data-animate="fade" data-animate-once>
    <a class="logo" href="/">Ivo Amaro</a>
  </div>

  <!-- Hamburger toggle -->
  <input type="checkbox" id="mobile-menu-toggle" />
  <label for="mobile-menu-toggle" class="hamburger">
    <span></span>
    <span></span>
    <span></span>
  </label>

  <!-- The fade sits on the items, not on .menu: the runner writes inline
       opacity and visibility on every [data-animate] element, which would
       outrank the #mobile-menu-toggle:checked rules that open the menu. -->
  <ul class="menu">
    <!-- <li><a href="/exploratory">Exploratory</a></li> -->
    <li data-animate="fade" data-animate-once><a href="/work">Work</a></li>
    <li data-animate="fade" data-animate-once><a href="/about">About</a></li>
    <li data-animate="fade" data-animate-once><a href="/blog">Blog</a></li>
    <!-- <li><Button title="Work" href="/work" showSymbol={false} /></li> -->
    <li data-animate="fade" data-animate-once><ThemeIcon /></li>
  </ul>
</nav>

<style>
  :global(.dark) nav {
    .hamburger span {
      background-color: var(--color-bg);
    }
  }

  @media (max-width: 768px) {
    :global(.dark) nav .menu {
      background-color: var(--color-text);
    }
  }

  #themeToggle {
    display: flex;
    align-items: center;
    justify-content: center;
  }
    	
  nav {
    font-family: var(--font-primary);
    font-weight: var(--font-bold);
    padding-block: var(--space-6);
    display: flex;
    justify-content: space-between;
    align-items: center;
    .logo {
      font-size: var(--step-2);
      text-decoration: none;
    }
    a {
      text-decoration: none;
    }
    ul {
      display: flex;
      > * + * {
        margin-left: var(--space-4);
      }

      li {
        list-style-type: none;
        display: flex;
        align-items: center;
        justify-content: center;
      }
    }

    #mobile-menu-toggle {
      display: none;
    }

    .hamburger {
      display: none;
      flex-direction: column;
      cursor: pointer;
      gap: 5px;
      /* width: 25px;
      height: 25px; */
      justify-content: center;
      align-items: center;
      padding: var(--space-4);
      padding-right:0;
      span {
        width: 25px;
        height: 2px;
        background-color: var(--color-text);
        transition: all var(--motion-fast) var(--motion-ease-standard);
        transform-origin: center;
      }
    }

    /* Responsive */
    @media (max-width: 768px) {
      .hamburger {
        display: flex;
      }

      .menu {
        align-items: center;
  
        position: absolute;
        z-index: 100;
        width: calc(100% - var(--space-4) * 2);
        margin: var(--space-4);
        top: var(--space-9);
        left: 0;
        padding: var(--space-4);
        border: var(--border-width) solid var(--color-text);
        border-radius: 20px;
        background-color: var(--color-bg);
        /* Fade-in properties */
        opacity: 0;
        visibility: hidden;
        transition:
          opacity var(--motion-fast) var(--motion-ease-standard),
          transform var(--motion-fast) var(--motion-ease-standard),
          visibility var(--motion-fast);
      }

      .menu li:last-child {
        margin-left: auto;
      }

      /* Toggle menu */
      #mobile-menu-toggle:checked + .hamburger + .menu {
        opacity: 1;
        visibility: visible;
      }

      /* Animate hamburger into X */
      #mobile-menu-toggle:checked + .hamburger span:nth-child(1) {
        transform: rotate(45deg) translate(4px, 4px);
      }

      #mobile-menu-toggle:checked + .hamburger span:nth-child(2) {
        opacity: 0;
      }

      #mobile-menu-toggle:checked + .hamburger span:nth-child(3) {
        transform: rotate(-45deg) translate(6px, -6px);
      }
    }
  }
</style>
