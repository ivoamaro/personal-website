---
import ThemeIcon from "./ui/ThemeIcon.astro";
---

<nav class="container">
  <div>
    <a href="/">Ivo Amaro</a>
  </div>

  <!-- Hamburger toggle -->
  <input type="checkbox" id="mobile-menu-toggle" />
  <label for="mobile-menu-toggle" class="hamburger">
    <span></span>
    <span></span>
    <span></span>
  </label>

  <ul class="menu">
    <!-- <li><a href="/exploratory">Exploratory</a></li> -->
    <li><a href="/work">Work</a></li>
    <li><ThemeIcon /></li>
  </ul>
</nav>

<style>
  :global(.dark) nav {
    .hamburger span {
      background-color: var(--color-bg);
    }
  }

  @media (max-width: 768px) {
    :global(.dark) nav .menu {
      background-color: var(--color-text);
    }
  }
  nav {
    font-family: var(--font-primary);
    font-weight: var(--font-bold);
    padding: var(--space-6);
    display: flex;
    justify-content: space-between;
    align-items: center;
    ul {
      display: flex;
      > * + * {
        margin-left: var(--space-4);
      }
      li {
        list-style-type: none;
        display: flex;
        align-items: center;
        justify-content: center;
      }
    }
    a {
      letter-spacing: var(--tracking-wide);
      text-decoration: none;
      transition: 0.2s ease-in-out;
      &:hover {
        color: var(--color-primary);
      }
    }

    #mobile-menu-toggle {
      display: none;
    }

    .hamburger {
      display: none;
      flex-direction: column;
      cursor: pointer;
      gap: 5px;
      width: 25px;
      height: 25px;
      justify-content: center;
      align-items: center;
      span {
        width: 25px;
        height: 1px;
        background-color: var(--color-text);
        transition: all 0.3s;
        transform-origin: center;
      }
    }

    /* Responsive */
    @media (max-width: 768px) {
      .hamburger {
        display: flex;
      }

      .menu {
        flex-direction: column;
        position: absolute;
        top: var(--height-navbar);
        left: calc(var(--space-4) + var(--border-width));
        width: calc(100% - var(--space-4) - (var(--border-width) * 3));
        padding: var(--space-4);
        background-color: var(--color-bg);
        /* Fade-in properties */
        opacity: 0;
        visibility: hidden;
        transition:
          opacity 0.3s ease,
          transform 0.3s ease,
          visibility 0.3s;
      }

      .menu li {
        margin-bottom: var(--space-3);
        margin-left: 0;
        &:last-child {
          margin-bottom: 0;
        }
      }

      /* Toggle menu */
      #mobile-menu-toggle:checked + .hamburger + .menu {
        opacity: 1;
        visibility: visible;
      }

      /* Animate hamburger into X */
      #mobile-menu-toggle:checked + .hamburger span:nth-child(1) {
        transform: rotate(45deg) translate(4px, 4px);
      }

      #mobile-menu-toggle:checked + .hamburger span:nth-child(2) {
        opacity: 0;
      }

      #mobile-menu-toggle:checked + .hamburger span:nth-child(3) {
        transform: rotate(-45deg) translate(4px, -4px);
      }
    }
  }
</style>
