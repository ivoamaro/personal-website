---
export interface LinkEntry {
  title: string;
  href: string;
}

export interface SkillSection {
  title: string;
  skills: {
    title: string;
  }[];
}

export interface Props {
  subtitle?: string;
  title?: string;
  tags?: string[];
  links?: LinkEntry[];
  description?: string;
  /** One skill group, or several (e.g. from CMS). */
  skillsList?: SkillSection | SkillSection[];
}

let {
  subtitle = "",
  title = "",
  tags = [],
  links = [],
  description = "",
  skillsList,
} = Astro.props;

const skillSections =
  skillsList == null
    ? []
    : Array.isArray(skillsList)
      ? skillsList
      : [skillsList];
---

<li class="list-item">
  {subtitle && <span class="small">{subtitle}</span>}
  {title && <p>{title}</p>}
  <div class="info-container">
    {
      links.length > 0 && (
        <ul class="links">
          {links.map((link, index) => (
            <li class="link-item">
              <a href={link.href} target="_blank" rel="noreferrer">
                {link.title}
              </a>
              {index >= links.length - 1 ? "" : ","}
            </li>
          ))}
          {tags.length > 0 && (
            <li>
              <span class="separator">|</span>
            </li>
          )}
        </ul>
      )
    }

    {
      tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag, index) => (
            <li>
              <span>{tag}</span>
              {index >= tags.length - 1 ? "" : ","}
            </li>
          ))}
        </ul>
      )
    }
  </div>

  {
    skillSections.length > 0 &&
      skillSections.map((section) => (
        <>
          <h3 class="small">{section.title}</h3>
          <ul class="skills">
            {section.skills.map((skill) => (
              <li>
                <span>{skill.title}</span>
              </li>
            ))}
          </ul>
        </>
      ))
  }
</li>

<style>
  .list-item {
    margin-bottom: var(--space-3);
    &:last-child {
      margin-bottom: 0;
    }
  }
  .info-container {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .tags {
    display: flex;
    gap: var(--space-1);
    font-size: var(--step--2);
    font-weight: var(--font-light);
    letter-spacing: var(--tracking-wide);
    font-style: italic;
    li {
      display: flex;
    }
    span {
      display: block;
    }
  }
  .links {
    display: flex;
    gap: var(--space-1);
    li {
      display: flex;
      list-style: none;
      font-size: var(--step--2);
      font-weight: var(--font-bold);
      letter-spacing: var(--tracking-wide);
      a {
        display: block;
      }
    }
  }
  .skills li:last-child {
    margin-bottom: var(--space-3);
  }
</style>
