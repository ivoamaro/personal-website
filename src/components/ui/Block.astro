---
export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["design-system-block", className]}>
  <slot />
</div>

<style>
  .design-system-block {
    padding: var(--space-4);
    font-family: var(--font-secondary);
  }

  .p-none {
    padding: 0;
  }
</style>
