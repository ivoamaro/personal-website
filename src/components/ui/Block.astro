---
export interface Props {
  side?: "left" | "right" | "top" | "bottom";
}

const { side = "left" } = Astro.props;

let border = "var(--border-width) dashed var(--color-text)";

switch (side) {
  case "right":
    border = "border-right: var(--border-width) dashed var(--color-text)";
    break;
  case "top":
    border = "border-top: var(--border-width) dashed var(--color-text)";
    break;
  case "bottom":
    border = "border-bottom: var(--border-width) dashed var(--color-text)";
    break;
  default:
    border = "border-left: var(--border-width) dashed var(--color-text)";
    break;
}
---

<div class="design-system-block col-3" style={border}>
  <slot />
</div>

<style>
  .design-system-block {
    padding: var(--space-4);
    font-family: var(--font-secondary);
    &:last-child {
      border-right: none;
    }
    &:first-child {
      border-left: none;
    }
  }
</style>
