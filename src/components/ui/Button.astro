---
import type { AnimationName } from "../../scripts/animations";

export interface Props {
  /** Render a `<button>` when true. Ignored when `href` is set (renders as a link). */
  isButton?: boolean;
  /** Open the link in a new tab. Only applies when rendering as an `<a>`. */
  isExternal?: boolean;
  /** URL for internal pages (`/about`) or external destinations. Presence of `href` renders an `<a>`. */
  href?: string;
  title?: string;
  /** Show or hide the trailing arrow symbol. */
  showSymbol?: boolean;
  /** Named animation recipe. Maps to `data-animate`. */
  animate?: AnimationName;
  /** Sequence group; on-screen members animate in document order. Maps to `data-animate-group`. */
  animateGroup?: string;
  /** Seconds to wait before the animation plays, overriding group order. Maps to `data-animate-delay`. */
  animateDelay?: number;
  /** ScrollTrigger start position. Maps to `data-animate-start`. */
  animateStart?: string;
}

let {
  isButton = true,
  isExternal = false,
  href = "",
  title = "",
  showSymbol = true,
  animate,
  animateGroup,
  animateDelay,
  animateStart,
} = Astro.props;

const isLink = Boolean(href) || !isButton;

if (title === "" && isLink) title = "Link";
else if (title === "") title = "Button";

const Tag = isLink ? "a" : "button";

// The group, delay and start attributes are meaningless without a recipe, and an
// empty `data-animate` would make the runner hide the button and never reveal it.
const animationAttributes = animate
  ? {
      "data-animate": animate,
      ...(animateGroup !== undefined && { "data-animate-group": animateGroup }),
      ...(animateDelay !== undefined && { "data-animate-delay": animateDelay }),
      ...(animateStart !== undefined && { "data-animate-start": animateStart }),
    }
  : {};

const arrowPath =
  "M0 4.48H10.304L8.848 5.472L3.36 0H6.416L12 5.6L6.416 11.2H3.36L8.848 5.728L10.304 6.72H0V4.48Z";
---

<style>
  .button-component {
    --button-symbol-size: var(--space-5);

    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    width: fit-content;
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-primary);
    font-size: var(--step-0);
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-normal);
    text-decoration: none;
    color: var(--color-text);
    background-color: var(--color-bg);
    border: var(--border-width) solid var(--color-text);
    border-radius: 999px;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    transition: transform 0.5s cubic-bezier(0.22, 0.68, 0, 1);
  }

  :global(.dark) .button-component {
    color: var(--color-bg);
    background-color: var(--color-text);
    border-color: var(--color-bg);
  }

  .symbol-wrap {
    /* Direction the symbols travel on hover, matching where the arrow points. */
    --symbol-shift-x: 100%;
    --symbol-shift-y: 0%;

    position: relative;
    width: var(--button-symbol-size);
    height: var(--button-symbol-size);
    overflow: hidden;
  }

  .symbol-wrap.is-external {
    --symbol-shift-y: -100%;
  }

  .symbol {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition: transform 0.4s ease;
  }

  /* Waits just outside the wrap, opposite the exit direction. */
  .symbol-incoming {
    transform: translate(
      calc(-1 * var(--symbol-shift-x)),
      calc(-1 * var(--symbol-shift-y))
    );
  }

  .symbol svg {
    display: block;
  }

  /* Rotating the svg instead of the symbol keeps the slide animation intact. */
  .symbol-wrap.is-external .symbol svg {
    transform: rotate(-45deg);
  }

  .button-component:hover {
    color: var(--color-text);
    transform: scale(1.1);
  }

  .button-component:hover .symbol-outgoing {
    transform: translate(var(--symbol-shift-x), var(--symbol-shift-y));
  }

  .button-component:hover .symbol-incoming {
    transform: translate(0, 0);
  }

  :global(.dark) .button-component:hover {
    color: var(--color-bg);
  }
</style>

<Tag
  class="button-component"
  {...animationAttributes}
  href={isLink ? href : undefined}
  target={isLink && isExternal ? "_blank" : undefined}
  rel={isLink && isExternal ? "noreferrer" : undefined}
  type={isLink ? undefined : "button"}
>
  <span>{title}</span>
  {
    showSymbol && (
      <span
        class:list={["symbol-wrap", { "is-external": isLink && isExternal }]}
        aria-hidden="true"
      >
        <span class="symbol symbol-incoming">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d={arrowPath} fill="currentColor" />
          </svg>
        </span>
        <span class="symbol symbol-outgoing">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d={arrowPath} fill="currentColor" />
          </svg>
        </span>
      </span>
    )
  }
</Tag>
