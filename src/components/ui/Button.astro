---
import type { AnimationName } from "../../scripts/animations";

export interface Props {
  /** Render a `<button>` when true. Ignored when `href` is set (renders as a link). */
  isButton?: boolean;
  /** Open the link in a new tab. Only applies when rendering as an `<a>`. */
  isExternal?: boolean;
  /** URL for internal pages (`/about`) or external destinations. Presence of `href` renders an `<a>`. */
  href?: string;
  title?: string;
  /** Show or hide the trailing arrow symbol. */
  showSymbol?: boolean;
  /** Named animation recipe. Maps to `data-animate`. */
  animate?: AnimationName;
  /** Seconds to wait before the animation plays. Maps to `data-animate-delay`. */
  animateDelay?: number;
  /** ScrollTrigger start position. Maps to `data-animate-start`. */
  animateStart?: string;
}

let {
  isButton = true,
  isExternal = false,
  href = "",
  title = "",
  showSymbol = true,
  animate,
  animateDelay,
  animateStart,
} = Astro.props;

const isLink = Boolean(href) || !isButton;

if (title === "" && isLink) title = "Link";
else if (title === "") title = "Button";

const Tag = isLink ? "a" : "button";

// The delay and start attributes are meaningless without a recipe, and an empty
// `data-animate` would make the runner hide the button and never reveal it.
const animationAttributes = animate
  ? {
      "data-animate": animate,
      ...(animateDelay !== undefined && { "data-animate-delay": animateDelay }),
      ...(animateStart !== undefined && { "data-animate-start": animateStart }),
    }
  : {};

const arrowPath =
  "M0 4.48H10.304L8.848 5.472L3.36 0H6.416L12 5.6L6.416 11.2H3.36L8.848 5.728L10.304 6.72H0V4.48Z";
---

<style>
  .button-component {
    --button-symbol-size: var(--space-5);

    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    width: fit-content;
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-primary);
    font-size: var(--step-0);
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-normal);
    text-decoration: none;
    color: var(--color-text);
    background-color: var(--color-bg);
    border: var(--border-width) solid var(--color-text);
    border-radius: 999px;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    transition: transform 0.5s cubic-bezier(0.22, 0.68, 0, 1);
  }

  :global(.dark) .button-component {
    color: var(--color-bg);
    background-color: var(--color-text);
    border-color: var(--color-bg);
  }

  .symbol-wrap {
    width: var(--button-symbol-size);
    height: var(--button-symbol-size);
    overflow: hidden;
  }

  .symbol-track {
    display: flex;
    width: max-content;
    transform: translateX(calc(-1 * var(--button-symbol-size)));
    transition: transform 0.4s ease;
  }

  .symbol {
    width: var(--button-symbol-size);
    height: var(--button-symbol-size);
    flex-shrink: 0;
    display: grid;
    place-items: center;
  }

  .symbol svg {
    display: block;
  }

  .button-component:hover {
    color: var(--color-text);
    transform: scale(1.1);
  }

  .button-component:hover .symbol-track {
    transform: translateX(0);
  }

  :global(.dark) .button-component:hover {
    color: var(--color-bg);
  }
</style>

<Tag
  class="button-component"
  {...animationAttributes}
  href={isLink ? href : undefined}
  target={isLink && isExternal ? "_blank" : undefined}
  rel={isLink && isExternal ? "noreferrer" : undefined}
  type={isLink ? undefined : "button"}
>
  <span>{title}</span>
  {
    showSymbol && (
      <span class="symbol-wrap" aria-hidden="true">
        <span class="symbol-track">
          <span class="symbol">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d={arrowPath} fill="currentColor" />
            </svg>
          </span>
          <span class="symbol">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d={arrowPath} fill="currentColor" />
            </svg>
          </span>
        </span>
      </span>
    )
  }
</Tag>
