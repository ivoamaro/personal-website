---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { AnimationName } from "../../scripts/animations";

export interface Props {
  /**
   * An imported image (`ImageMetadata`) or a public-folder URL such as `/photo.jpeg`.
   * Public paths cannot be processed by `astro:assets`, so they render as a native `img`.
   */
  src: ImageMetadata | string;
  alt: string;
  class?: string;
  /** Named animation recipe. Maps to `data-animate`. */
  animate?: AnimationName;
  /** Sequence group; on-screen members animate in document order. Maps to `data-animate-group`. */
  animateGroup?: string;
  /** Seconds to wait before the animation plays, overriding group order. Maps to `data-animate-delay`. */
  animateDelay?: number;
  /** ScrollTrigger start position. Maps to `data-animate-start`. */
  animateStart?: string;
  /** Load eagerly at high priority. Use for above-the-fold images so they do not delay LCP. */
  priority?: boolean;
}

const {
  src,
  alt,
  class: className,
  animate,
  animateGroup,
  animateDelay,
  animateStart,
  priority = false,
} = Astro.props;

const classes = [animate ? undefined : "fade-image", className]
  .filter(Boolean)
  .join(" ");

const publicSrc = typeof src === "string" ? src : undefined;
const importedSrc = typeof src === "string" ? undefined : src;
const loading = priority ? "eager" : "lazy";
const fetchpriority = priority ? "high" : "auto";
const onload = animate ? undefined : "this.classList.add('is-loaded')";
---

{
  publicSrc ? (
    <img
      src={publicSrc}
      alt={alt}
      class={classes}
      data-animate={animate}
      data-animate-group={animateGroup}
      data-animate-delay={animateDelay}
      data-animate-start={animateStart}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      onload={onload}
    />
  ) : importedSrc ? (
    <Image
      src={importedSrc}
      alt={alt}
      class={classes}
      data-animate={animate}
      data-animate-group={animateGroup}
      data-animate-delay={animateDelay}
      data-animate-start={animateStart}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      onload={onload}
    />
  ) : null
}

<style>
  .fade-image {
    opacity: 0;
    transition: opacity var(--motion-slow) var(--motion-ease-standard);
  }

  .fade-image.is-loaded {
    opacity: 1;
  }
</style>
