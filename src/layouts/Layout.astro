---
import "../styles/global.css";
import "../styles/layout.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import InDevelopmentBanner from "../components/design-system/InDevelopmentBanner.astro";

//const isProtected = isSitePasswordCorrect("");

const showSite = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Instrument+Serif:ital@0;1&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Ivo Amaro</title>
    <ClientRouter />

    <script is:inline>
      function applyTheme() {
        const stored = localStorage.getItem("theme");

        const systemDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;

        const theme =
          stored === "dark" || stored === "light"
            ? stored
            : systemDark
              ? "dark"
              : "light";

        document.documentElement.classList.toggle("dark", theme === "dark");
        localStorage.setItem("theme", theme);
      }

      applyTheme();
      // ClientRouter resets <html> attributes on swap; re-apply before paint.
      document.addEventListener("astro:after-swap", applyTheme);
    </script>
  </head>
  <body>
    {
      showSite ? (
        <>
          <Navbar />
          <main class="content">
            <slot />
          </main>
          <Footer />
        </>
      ) : (
        <InDevelopmentBanner />
      )
    }

    <script>
      import "../scripts/SmoothScroll.ts";
    </script>
  </body><style>
    .dark .content {
      border-inline: var(--border-width) dashed var(--color-bg);
    }
    .content {
      border-inline: var(--border-width) dashed var(--color-text);
      margin-inline: var(--space-4);
      padding-top: calc(var(--space-5) * 2);
      padding-bottom: var(--height-footer);
      /* min-height: 100vh; */
    }
  </style>
</html>
