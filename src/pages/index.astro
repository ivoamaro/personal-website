---
import Layout from "../layouts/Layout.astro";
import Header from "../components/design-system/Header.astro";
import Block from "../components/ui/Block.astro";
import ListItem from "../components/design-system/ListItem.astro";
import { getCollection, getEntry } from "astro:content";

// const allHomepage = await getCollection("homepage");
// console.log(allHomepage);

const header = {
  title:
    "Creative designer and developer working at the intersection of design and code. I’m naturally curious and love learning and discovering new things.",
  work: {
    title: "Work",
    items: [
      {
        title: "Pollock — Krasner House",
        description:
          "A website for the Pollock — Krasner House, a museum and research center dedicated to the life and work of the artists Jackson Pollock and Lee Krasner.",
        tags: ["Design", "Development"],
        links: [
          {
            title: "Website",
            href: "https://www.pollock.com",
          },
          {
            title: "GitHub",
            href: "https://github.com/pollock-krasner-house",
          },
        ],
      },
      {
        title: "Talkhouse",
        tags: ["Design", "Development"],
      },
      {
        title: "Encore",
        tags: ["Design", "Development"],
      },
      {
        title: "Larota",
        tags: ["Design", "Development"],
      },
    ],
  },
  skills: {
    title: "Skills",
    items: [
      {
        title: "Design",
        skills: [
          {
            title: "Figma",
          },
          {
            title: "Adobe",
          },
        ],
      },
      {
        title: "Development",
        skills: [
          {
            title: "React",
          },
          {
            title: "Astro",
          },
          {
            title: "JavaScript",
          },
          {
            title: "HTML",
          },
          {
            title: "CSS",
          },
        ],
      },
    ],
  },
  education: {
    title: "Education",
    items: [
      {
        degree: "Bachelor’s degree in Design and Multimedia",
        year: "University of Coimbra | 2015 - 2018 ",
      },
      {
        degree: "Master’s degree in Multimedia",
        year: "University of Porto | 2018 - 2020",
      },
    ],
  },
  experience: {
    title: "Experience",
    items: [
      {
        title: "Prémio Jovem Criador",
        year: "2018",
      },
      {
        title: "Freelancer",
        year: "2021",
      },
      {
        title: "Made by Sea",
        year: "2021-Current",
      },
    ],
  },
  about: {
    p1: "Creative developer and designer with 5 years of experience working at the intersection of design and code. Over the years, I’ve worked with JavaScript frameworks and technologies such as React (Next.js), Svelte (SvelteKit), and TypeScript. ",
    p2: "A core part of my workflow has been collaborating closely with design teams across both design and development, bridging the gap between visual intent and technical execution.",
  },
};
---

<Layout>
  <Header title={header.title} />
  <section class="container grid gap-0">
    <Block
      class="col-full lg:col-4 b-bottom lg:b-remove-bottom md:b-remove-right lg:b-right"
    >
      <h2>About</h2>
      <p>{header.about.p1}</p>
      <p>{header.about.p2}</p>
    </Block>
    <Block class="b-bottom md:b-right lg:b-remove-bottom col-full md:col-3">
      <h2>{header.work.title}</h2>
      <ul>
        {
          header.work.items.map((item) => (
            <ListItem
              title={item.title}
              description={item.description}
              tags={item.tags}
              links={item.links}
            />
          ))
        }
      </ul>
    </Block>
    <Block class="b-bottom lg:b-right lg:b-remove-bottom col-full md:col-2">
      <h2>{header.skills.title}</h2>
      <ul>
        {header.skills.items.map((item) => <ListItem skillsList={item} />)}
      </ul>
    </Block>
    <Block class="col-full lg:col-3 p-none">
      <Block class="b-bottom">
        <h2>{header.experience.title}</h2>
        <ul>
          {
            header.experience.items.map((item) => (
              <ListItem subtitle={item.year} title={item.title} />
            ))
          }
        </ul>
      </Block>
      <Block>
        <h2>{header.education.title}</h2>
        <ul>
          {
            header.education.items.map((item) => (
              <ListItem subtitle={item.year} title={item.degree} />
            ))
          }
        </ul>
      </Block>
    </Block>
  </section>
</Layout>
