---
import Layout from "../layouts/Layout.astro";
import Header from "../components/design-system/Header.astro";
import Block from "../components/ui/Block.astro";

const header = {
  title:
    "Creative designer and developer working at the intersection of design and code. I’m naturally curious and love learning and discovering new things.",
};
---

<Layout>
  <Header title={header.title} />
  <section class="container grid gap-0">
    <Block side="right">
      <p>Work</p>
    </Block>
    <Block side="right">
      <p>{header.title}</p>
    </Block>
  </section>
</Layout>
