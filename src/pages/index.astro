---
import Layout from "../layouts/Layout.astro";
import Header from "../components/design-system/Header.astro";
import Block from "../components/ui/Block.astro";

const header = {
  title:
    "Creative designer and developer working at the intersection of design and code. I’m naturally curious and love learning and discovering new things.",
};
---

<Layout>
  <Header title={header.title} />
  <section class="container grid gap-0">
    <Block class="b-bottom md:b-right md:b-remove-bottom col-full md:col-3">
      <p>Work</p>
    </Block>

    <Block class="b-none lg:b-right col-full md:col-3 p-none">
      <Block class="b-bottom">
        <p>{header.title}</p>
      </Block>
      <Block>
        <p>{header.title}</p>
      </Block>
    </Block>

    <Block class="b-top lg:b-remove-top col-full md:col-6">
      <p>Work</p>
    </Block>
  </section>
</Layout>
