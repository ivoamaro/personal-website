---
import type { ImageMetadata } from "astro";
import Layout from "../layouts/Layout.astro";
import Header from "../components/design-system/Header.astro";
import Button from "../components/ui/Button.astro";
import CustomImage from "../components/ui/CustomImage.astro";
import ProfileImage from "../assets/photo.jpeg";

/**
 * Hover previews are matched to work items by filename, so a new preview is
 * added by dropping `<slug>.jpg` into `src/assets/work/`. Resolving through a
 * glob instead of static imports means an item without an image simply has no
 * preview rather than failing the build.
 */
const previewModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/work/*.{jpg,jpeg,png,webp}",
  { eager: true },
);

const previews = new Map(
  Object.entries(previewModules).map(([path, module]) => [
    path.split("/").pop()!.replace(/\.[^.]+$/, ""),
    module.default,
  ]),
);

const header = {
  title:
    "Creative designer and developer working at the intersection of design and code. I’m naturally curious and love learning and discovering new things.",
  work: {
    title: "Work",
    items: [
      {
        title: "Pollock — Krasner House",
        slug: "pollock",
        description:
          "A website for the Pollock — Krasner House, a museum and research center dedicated to the life and work of the artists Jackson Pollock and Lee Krasner.",
        tags: ["Design", "Development"],
        links: [
          {
            title: "Website",
            href: "https://www.pkhouse.org",
          },
          {
            title: "Figma",
            href: "https://www.figma.com/design/bi45COsUoJnTZ91zghOng9/Portfolio?node-id=21-4368",
          },
          {
            title: "More",
            href: "/work/pollock-krasner-house",
          },
        ],
      },
      {
        title: "Talkhouse",
        slug: "talkhouse",
        tags: ["Design", "Development"],
        links: [
          {
            title: "Website",
            href: "https://www.stephentalkhouse.com",
          },
        ],
      },
      {
        title: "Encore",
        slug: "encore",
        tags: ["Design", "Development"],
        links: [
          {
            title: "Website",
            href: "https://www.talkencore.com",
          },
        ],
      },
      {
        title: "Larota",
        slug: "larota",
        tags: ["Design", "Development"],
        links: [
          {
            title: "Website",
            href: "https://www.larota.co",
          },
        ],
      },
      {
        title: "Typographia",
        slug: "typographia",
        tags: ["Development"],
        links: [
          {
            title: "Website",
            href: "https://typographia.com",
          },
        ],
      },
    ],
  },
  skills: {
    title: "Skills",
    items: [
      {
        title: "Design",
        skills: [
          {
            title: "Figma",
          },
          {
            title: "Adobe",
          },
        ],
      },
      {
        title: "Development",
        skills: [
          {
            title: "React",
          },
          {
            title: "Svelte",
          },
          {
            title: "Astro",
          },
          {
            title: "JavaScript",
          },
          {
            title: "HTML",
          },
          {
            title: "CSS",
          },
          {
            title: "Webflow",
          },
        ],
      },
    ],
  },


  about: {
    p1: "I’m a designer and developer working at the intersection of design and technology. Over the years, I’ve designed websites in Figma and brought them to life using Javascript frameworks.",
    p2: "I enjoy working across both design and development, turning visual ideas into thoughtful, functional digital experiences.",
    p3: "Outside of work, I spend my time watching movies, playing games, creating music and doing some sport.",
  },
};
---

<Layout>
  <Header title={header.title}>
    <Button
      title="Let's chat"
      isButton={false}
      isExternal={true}
      href="mailto:ivo.amaro.97.p@gmail.com"
    />
  </Header>
  <section class="space-y-10">
    <div class="grid">
      <div class="col-full md:col-4">
        <div class="work-preview">
          <CustomImage
            src={ProfileImage}
            alt="Profile"
            class="round-corners"
            animate="fade"
            animateGroup="page"
            priority
          />
          {
            header.work.items.map((item, index) => {
              const preview = previews.get(item.slug);
              return preview ? (
                <div class="work-preview-layer" data-work-preview={index}>
                  <CustomImage
                    src={preview}
                    alt={item.title}
                    class="round-corners"
                  />
                </div>
              ) : null;
            })
          }
        </div>
      </div>
      <div class="col-full md:col-2"></div>
      <div class="col-full md:col-6">
        <h2 data-animate="fade" data-animate-group="page">Selected Work</h2>
        <ul data-animate="children" data-animate-group="page" data-work-list>
          {
            header.work.items.map((item, index) => (
              <li data-work-item={index}>
                <p>
                  <a href={item.links[0].href} target="_blank" class="no-underline">
                    {item.title}
                  </a>
                </p>
                {/* {item.tags.map((tag) => (
                  <span>{tag}</span>
                ))} */}
                {/* <ul class="button-container">
                  {item.links.map((link) => (
                    <li class="">
                      <Button
                        title={link.title}
                        href={link.href}
                        isExternal={link.href.includes("https://") ? true : false}
                      />
                    </li>
                  ))}
                </ul> */}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
  <section class="">
    <div class="grid about-section">
      <div class="col-full lg:col-6" data-animate="children">
        <h2>About</h2>
        <p>{header.about.p1}</p>
        <p>{header.about.p2}</p>
        <p>{header.about.p3}</p>
        <div class="button-container space-y-6">
          <Button title="Learn more" href="/about" />
          <Button title="CV" href="/cv.pdf" isExternal={true} />
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { initWorkPreview } from "../scripts/workPreview.ts";

  document.addEventListener("astro:page-load", initWorkPreview);
</script>

<style>
  /* The profile image stays in flow and sizes the box; previews stack on top. */
  .work-preview {
    position: relative;
  }

  .work-preview-layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--motion-base) var(--motion-ease-standard);
  }

  .work-preview-layer.is-active {
    opacity: 1;
  }

  /* The <img> is rendered by CustomImage, so it falls outside this scope. */
  .work-preview-layer :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: reduce) {
    .work-preview-layer {
      transition: none;
    }
  }

  .about-section {
    margin-block: var(--space-6);
    p {
      margin-top: var(--space-4);
    }
  }
</style>
