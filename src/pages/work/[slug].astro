---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/design-system/Header.astro";
import Block from "../../components/ui/Block.astro";
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const entries = await getCollection("work");
  return entries
    .filter((entry) => entry.data.status === "Published")
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const index = entry.rendered?.metadata?.headings as {
  slug: string;
  text: string;
}[];
---

<Layout>
  <Header title={entry.data.title} />
  <section>
    <div class="grid">
      <div class="col-full lg:col-7">
        <div class="prose">
          <Content />
        </div>  
      </div>
      <div class="col-full lg:col-1"></div>
      <div class="col-full lg:col-4">
        <div class="index-container">
          <h2>Index</h2>
          <ul>
            {
              index?.map((heading: any) => {
                if (heading.depth === 2) {
                  return (
                    <li>
                      <a href={`#${heading.slug}`}>{heading.text}</a>
                    </li>
                  );
                }
                return null;
              })
            }
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>

a {
 
  text-decoration: none;
  font-size: var(--step-2);
}

  /* Markdown body styles. <Content /> renders unscoped HTML, so its
     children need :global(). The scoped .prose wrapper keeps these
     rules limited to this page. */
  .prose {
    :global(p) {
      margin-bottom: var(--space-4);
    }

    /* More space above an image paragraph that follows a heading */
    :global(h2 + p:has(img)) {
      margin-top: var(--space-4);
    }

    :global(h2:not(:first-child)) {
      padding-top: var(--space-6);
    }

    :global(h3) {
      margin-bottom: var(--space-4);
    }

    :global(ul) {
      margin-bottom: var(--space-3);
    }

    :global(li) {
      list-style-type: none;
      padding: 0;
    }

    /* Two images in one paragraph sit side by side */
    :global(p:has(> img:first-child:nth-last-child(2))) {
      display: flex;
      gap: var(--space-4);

      :global(img) {
        width: 50%;
      }
    }
  }



  @media (min-width: 1024px) {
    .index-container {
      position: sticky;
      top: var(--space-4);
    }
  }
</style>
