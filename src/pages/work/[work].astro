---
import { sanityClient } from "sanity:client";
import Layout from "../../layouts/Layout.astro";
import type { Project } from "../../sanity/sanity.types";

export async function getStaticPaths() {
  const projects = await sanityClient.fetch<Project[]>(`*[_type == "project"]{ slug }`);
  return projects.map((p) => ({
    params: { work: p.slug?.current },
  }));
}

const { work } = Astro.params;
const project = await sanityClient.fetch<Project>(
  `*[_type == "project" && slug.current == $slug][0]{ title, description, image }`,
  { slug: work }
);
---

<Layout>
  <div class="container">
    <h2>{project.title}</h2>
    <p>{project.description}</p>
  </div>
</Layout>