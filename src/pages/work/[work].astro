---
import Layout from "../../layouts/Layout.astro";
import type { Project } from "../../sanity/sanity.types";
import { loadQuery } from "../../sanity/lib/load-query";
import { urlForImage } from "../../sanity/lib/url-for-image";
import PortableText from "../../components/PortableText/PortableText.astro";

export async function getStaticPaths() {
  const projects = await loadQuery<Project[]>({
    query: `*[_type == "project"]{ slug }`,
  });

  return projects.data.map((p: Project) => ({
    params: { work: p.slug?.current },
  }));
}

const { work } = Astro.params;

const { data: project } = await loadQuery<Project>({
  query: `*[_type == "project" && slug.current == $slug][0]{
    title, description, body, image,
    seo { metaTitle, metaDescription, ogImage { asset } }
  }`,
  params: { slug: work! },
});

const seoTitle = project.seo?.metaTitle || project.title || "Project";
const seoDescription = project.seo?.metaDescription || project.description;
const seoOgImage = project.seo?.ogImage?.asset
  ? urlForImage(project.seo.ogImage.asset).width(1200).height(630).url()
  : undefined;
---

<Layout title={seoTitle} description={seoDescription} ogImage={seoOgImage}>
  <div class="container">
    <h2>{project.title}</h2>
    <p>{project.description}</p>
    {project.body && <PortableText portableText={project.body} />}
  </div>
</Layout>