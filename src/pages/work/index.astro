---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/design-system/Header.astro";
import { getCollection } from "astro:content";

// Must match the filter in `[slug].astro`; listing an unpublished entry here
// links to a route that was never generated.
const entries = await getCollection(
  "work",
  (entry) => entry.data.status === "Published",
);
---

<Layout>
  <Header title="Work" />
  <section class="grid gap-0" data-animate="children" data-animate-group="page">
    {
      entries.map((entry) => (
        <div class="col-full">
          <p>
            <a href={`/work/${entry.id}`}>{entry.data.title}</a>
          </p>
        </div>
      ))
    }
  </section>
</Layout>
