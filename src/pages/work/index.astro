---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/design-system/Header.astro";
import Block from "../../components/ui/Block.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("work");
---

<Layout>
  <Header title="Work" />
  <section class="grid gap-0">
    {
      entries.map((entry) => (
        <div class="col-full">
          <p>
            <a href={`/work/${entry.id}`}>{entry.data.title}</a>
          </p>
        </div>
      ))
    }
  </section>
</Layout>
