{
	"compatibility_date": "2026-05-19",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "personal-website",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "BINDING_NAME",
			"id": "cb4e87e0cdd24e90ab2ef6ca73ab3def",
			"remote": true
		}
	]
}